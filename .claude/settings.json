{
  "env": {
    "PYTHONUTF8": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "GCM_INTERACTIVE": "never"
  },
  "permissions": {
    "allow": [
      "Skill(job-application-assistant)",
      "Bash(bun run .agents/skills/linkedin-search/cli/src/cli.ts:*)",
      "Bash(bun run .agents/skills/freehire-search/cli/src/cli.ts:*)",
      "Bash(python salary_lookup.py:*)",
      "Bash(python3 salary_lookup.py:*)",
      "Bash(python tools/verify_pdf.py:*)",
      "Bash(python3 tools/verify_pdf.py:*)",
      "Bash(pdftotext:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch origin:*)",
      "Bash(git merge origin/master:*)",
      "Bash(git push -u origin HEAD)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(git switch --detach origin/master)",
      "Bash(python3 tools/sync_app.py:*)",
      "Bash(./tools/ci_local.sh:*)",
      "ArtifactData",
      "ArtifactComments"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}\"/tools/py.sh \"${CLAUDE_PROJECT_DIR}\"/tools/learned.py hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}\"/tools/py.sh \"${CLAUDE_PROJECT_DIR}\"/tools/learned.py hook"
          }
        ]
      }
    ]
  }
}
